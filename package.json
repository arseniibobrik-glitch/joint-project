{
  "name": "notion-base",
  "version": "0.0.0",
  "private": true,
  "description": "Notion-like data layer: blocks, pages, databases, realtime",
  "scripts": {
    "dev": "pnpm --filter=api dev",
    "dev:realtime": "pnpm --filter=realtime dev",
    "db:generate": "pnpm --filter=db generate",
    "db:push": "pnpm --filter=db push",
    "db:studio": "pnpm --filter=db studio",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0"
  },
  "packageManager": "pnpm@9.6.0",
  "engines": {
    "node": ">=20.0.0"
  }
}