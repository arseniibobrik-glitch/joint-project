{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@notion-base/shared": ["packages/shared/src"],
      "@notion-base/db": ["packages/db/src"],
      "@notion-base/api": ["packages/api/src"],
      "@notion-base/realtime": ["packages/realtime/src"],
      "@notion-base/auth": ["packages/auth/src"]
    }
  },
  "exclude": ["node_modules", "dist"]
}